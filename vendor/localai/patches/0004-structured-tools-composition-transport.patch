diff --git a/core/http/endpoints/openai/tool_policy.go b/core/http/endpoints/openai/tool_policy.go
index 526c515..eda279d 100644
--- a/core/http/endpoints/openai/tool_policy.go
+++ b/core/http/endpoints/openai/tool_policy.go
@@ -11,10 +11,37 @@ import (
 )
 
 const (
-	phaseShiftToolPolicyTransportKey = "phaseshift.tool_policy_transport"
-	phaseShiftParallelToolCallsKey   = "phaseshift.parallel_tool_calls"
+	phaseShiftToolPolicyTransportKey   = "phaseshift.tool_policy_transport"
+	phaseShiftParallelToolCallsKey     = "phaseshift.parallel_tool_calls"
+	phaseShiftConstraintCompositionKey = "phaseshift.constraint_composition_transport"
 )
 
+// SetPhaseShiftConstraintCompositionMetadata marks (or clears) the reserved
+// composition transport key. It is always called so a client-supplied value
+// can never survive.
+func SetPhaseShiftConstraintCompositionMetadata(cfg *config.ModelConfig, enabled bool) {
+	metadata := map[string]string{}
+	for key, value := range cfg.RequestMetadata {
+		metadata[key] = value
+	}
+	if enabled {
+		metadata[phaseShiftConstraintCompositionKey] = "1"
+	} else {
+		delete(metadata, phaseShiftConstraintCompositionKey)
+	}
+	cfg.RequestMetadata = metadata
+}
+
+// StripPhaseShiftReservedMetadata removes the reserved tool-policy keys from a
+// client-supplied metadata map. LocalAI merges request metadata into the
+// backend options after the model config is built, so the keys must be removed
+// from the request map as well to prevent spoofing.
+func StripPhaseShiftReservedMetadata(metadata map[string]string) {
+	delete(metadata, phaseShiftToolPolicyTransportKey)
+	delete(metadata, phaseShiftParallelToolCallsKey)
+	delete(metadata, phaseShiftConstraintCompositionKey)
+}
+
 // SetPhaseShiftToolPolicyMetadata stamps the reserved tool-policy transport
 // keys onto the per-request metadata. The reserved keys are always
 // overwritten so a client cannot spoof them.
