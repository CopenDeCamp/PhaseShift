+			return nil, fmt.Errorf("unsupported text.format type: %s", tfType)
 		}
-	case string:
-		return map[string]any{"type": tf}
+	default:
+		return nil, fmt.Errorf("malformed text.format: %T", textFormat)
 	}
-	return nil
 }
 
