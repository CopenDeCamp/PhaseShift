-					"json_schema": tf,
-				}
+		tfType, ok := tf["type"].(string)
+		if !ok || tfType == "" {
+			return nil, errors.New("text.format type is required")
+		}
+		switch tfType {
+		case "text", "json_object":
+			return map[string]any{"type": tfType}, nil
+		case "json_schema":
