+// resolveResponseTextFormat returns the effective Responses text format. The
+// canonical surface is text.format; text_format is a legacy alias. Supplying
+// both is ambiguous and rejected. A text object without a format is malformed.
+func resolveResponseTextFormat(input *schema.OpenResponsesRequest) (any, error) {
+	hasCanonical := input.Text != nil && input.Text.Format != nil
+	hasLegacy := input.TextFormat != nil
+	if hasCanonical && hasLegacy {
+		return nil, errors.New("text.format and text_format cannot be used together")
+	}
+	if input.Text != nil && input.Text.Format == nil && !hasLegacy {
+		return nil, errors.New("text.format is required when text is provided")
+	}
+	if hasCanonical {
+		return input.Text.Format, nil
+	}
+	if hasLegacy {
+		return input.TextFormat, nil
+	}
+	return nil, nil
+}
+
+// convertTextFormatToResponseFormat converts Open Responses text format to the
+// OpenAI-compatible response_format consumed by the shared grammar helper. It
+// validates the shape so an unsupported or malformed format is reported as an
+// error instead of silently degrading to unconstrained generation.
+func convertTextFormatToResponseFormat(textFormat any) (any, error) {
 	switch tf := textFormat.(type) {
+	case nil:
+		return nil, nil
+	case string:
+		switch tf {
+		case "text":
+			return map[string]any{"type": "text"}, nil
+		case "json_object":
+			return map[string]any{"type": "json_object"}, nil
+		case "json_schema":
+			return nil, errors.New("json_schema text format requires a name and schema")
+		default:
+			return nil, fmt.Errorf("unsupported text.format type: %s", tf)
+		}
 	case map[string]any:
-		if tfType, ok := tf["type"].(string); ok {
-			if tfType == "json_schema" {
-				return map[string]any{
