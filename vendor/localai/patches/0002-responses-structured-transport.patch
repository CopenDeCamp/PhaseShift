diff --git a/core/http/endpoints/openai/response_format.go b/core/http/endpoints/openai/response_format.go
new file mode 100644
index 0000000..c43d67d
--- /dev/null
+++ b/core/http/endpoints/openai/response_format.go
@@ -0,0 +1,65 @@
+package openai
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/mudler/LocalAI/core/config"
+	"github.com/mudler/LocalAI/core/schema"
+	"github.com/mudler/LocalAI/pkg/functions"
+)
+
+// ResponseFormatGrammar converts an OpenAI-compatible response_format value
+// into a GBNF grammar. It is shared by the Chat Completions and Responses
+// transport paths so both surfaces enforce exactly the same fail-closed
+// semantics.
+//
+// The returned "constrained" flag reports whether the request asked for
+// structured output. When constrained is true the returned grammar is
+// non-empty on success, and any conversion failure is returned as an error so
+// the caller can reject the request before generation starts.
+func ResponseFormatGrammar(responseFormat any, cfg *config.ModelConfig) (string, bool, error) {
+	if responseFormat == nil {
+		return "", false, nil
+	}
+
+	var d schema.ChatCompletionResponseFormat
+	dat, err := json.Marshal(responseFormat)
+	if err != nil {
+		return "", false, fmt.Errorf("invalid response_format: %w", err)
+	}
+	if err := json.Unmarshal(dat, &d); err != nil {
+		return "", false, fmt.Errorf("invalid response_format: %w", err)
+	}
+
+	switch d.Type {
+	case "":
+		return "", false, fmt.Errorf("response_format type is required")
+	case "text":
+		return "", false, nil
+	case "json_object":
+		if strings.TrimSpace(functions.JSONBNF) == "" {
+			return "", true, fmt.Errorf("response_format json_object produced an empty grammar (internal invariant)")
+		}
+		return functions.JSONBNF, true, nil
+	case "json_schema":
+		var js schema.JsonSchemaRequest
+		if err := json.Unmarshal(dat, &js); err != nil {
+			return "", true, fmt.Errorf("invalid response_format json_schema: %w", err)
+		}
+		fs := &functions.JSONFunctionStructure{
+			AnyOf: []functions.Item{js.JsonSchema.Schema},
+		}
+		g, err := fs.Grammar(cfg.FunctionsConfig.GrammarOptions()...)
+		if err != nil {
+			return "", true, fmt.Errorf("invalid or unsupported response_format json_schema: %w", err)
+		}
+		if strings.TrimSpace(g) == "" {
+			return "", true, fmt.Errorf("response_format json_schema produced an empty grammar")
+		}
+		return g, true, nil
+	default:
+		return "", false, fmt.Errorf("unsupported response_format type: %s", string(d.Type))
+	}
+}
