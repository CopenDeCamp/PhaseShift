+// sendOpenResponsesInferenceError maps a backend inference failure onto the
+// Responses error surface. A request rejected before generation is a client
+// error (400); anything else is a model error (500).
+func sendOpenResponsesInferenceError(c echo.Context, err error) error {
+	if status.Code(err) == codes.InvalidArgument {
+		return sendOpenResponsesError(c, 400, "invalid_request", status.Convert(err).Message(), "")
+	}
+	return sendOpenResponsesError(c, 500, "model_error", fmt.Sprintf("model inference failed: %v", err), "")
+}
