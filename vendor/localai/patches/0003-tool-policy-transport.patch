diff --git a/core/http/endpoints/openai/tool_policy.go b/core/http/endpoints/openai/tool_policy.go
new file mode 100644
index 0000000..526c515
--- /dev/null
+++ b/core/http/endpoints/openai/tool_policy.go
@@ -0,0 +1,51 @@
+package openai
+
+import (
+	"net/http"
+	"strconv"
+
+	"github.com/labstack/echo/v4"
+	"github.com/mudler/LocalAI/core/config"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+const (
+	phaseShiftToolPolicyTransportKey = "phaseshift.tool_policy_transport"
+	phaseShiftParallelToolCallsKey   = "phaseshift.parallel_tool_calls"
+)
+
+// SetPhaseShiftToolPolicyMetadata stamps the reserved tool-policy transport
+// keys onto the per-request metadata. The reserved keys are always
+// overwritten so a client cannot spoof them.
+func SetPhaseShiftToolPolicyMetadata(cfg *config.ModelConfig, parallel *bool) {
+	metadata := map[string]string{}
+	for key, value := range cfg.RequestMetadata {
+		metadata[key] = value
+	}
+	metadata[phaseShiftToolPolicyTransportKey] = "1"
+	enabled := true
+	if parallel != nil {
+		enabled = *parallel
+	}
+	metadata[phaseShiftParallelToolCallsKey] = strconv.FormatBool(enabled)
+	cfg.RequestMetadata = metadata
+}
+
+// IsBackendClientError reports whether a backend error is a client error
+// (the request was rejected before generation).
+func IsBackendClientError(err error) bool {
+	return err != nil && status.Code(err) == codes.InvalidArgument
+}
+
+// MapBackendError converts a backend gRPC error into the matching HTTP error.
+// A request the backend rejected before generation is a client error (400).
+func MapBackendError(err error) error {
+	if err == nil {
+		return nil
+	}
+	if status.Code(err) == codes.InvalidArgument {
+		return echo.NewHTTPError(http.StatusBadRequest, status.Convert(err).Message())
+	}
+	return err
+}
